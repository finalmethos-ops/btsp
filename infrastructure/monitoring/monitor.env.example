# Copy this file to .runtime/monitoring/monitor.env and keep it private.
BTSP_PUBLIC_ORIGIN=https://purchasing-events.us
BTSP_REQUIRE_CLOUDFLARE=true

# Optional generic JSON webhook. Leave empty to retain alerts locally only.
BTSP_ALERT_WEBHOOK_URL=

# Local watchdog and capacity thresholds.
BTSP_MONITOR_DISK_WARNING_PERCENT=85
BTSP_MONITOR_BACKUP_MAX_AGE_HOURS=36
BTSP_MONITOR_RESTART_WARNING_COUNT=3
BTSP_MONITOR_5XX_WARNING_COUNT=5
BTSP_MONITOR_LOG_LOOKBACK=6m
BTSP_MONITOR_LOG_MAX_BYTES=10485760
BTSP_MONITOR_LOG_ARCHIVES=7

# Per-container Docker log retention. These are read by Docker Compose.
BTSP_CONTAINER_LOG_MAX_SIZE=20m
BTSP_CONTAINER_LOG_MAX_FILES=10
